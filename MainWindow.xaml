<Window x:Class="ContextMenuManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContextMenuManager"
        mc:Ignorable="d"
        Title="Sağ Tık Yöneticisi" 
        Height="780" Width="1020" 
        MinHeight="650" MinWidth="850" 
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource WindowBgBrush}" 
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontSize="14" 
        FontFamily="Segoe UI, Roboto, Helvetica"
        Icon="Assets/app_icon.png"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    
    <Window.Resources>
        <!-- Theme Brushes -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LabelTextBrush" Color="#475569"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="BtnPrimaryBgBrush" Color="#334155"/>
        <SolidColorBrush x:Key="BtnSecondaryTextBrush" Color="#334155"/>
        <SolidColorBrush x:Key="DataGridAlternatingBgBrush" Color="#F8FAFC"/>

        <!-- Form Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnPrimaryBgBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnSecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#64748B"/>
                                <Setter Property="BorderThickness" TargetName="border" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style with Custom Template -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="{x:Static SystemParameters.VerticalScrollBarWidth}" Width="0"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Toggle Button that covers the entire ComboBox -->
                            <ToggleButton x:Name="toggleButton" 
                                          Grid.ColumnSpan="2" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="6" 
                                                SnapsToDevicePixels="true">
                                            <Grid HorizontalAlignment="Right" Width="30">
                                                <!-- Dropdown arrow icon -->
                                                <Path x:Name="arrow" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Fill="{DynamicResource SecondaryTextBrush}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="true">
                                                <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="#64748B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <!-- Content Area -->
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              IsHitTestVisible="false" 
                                              Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            
                            <!-- Popup containing the dropdown items -->
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   Grid.ColumnSpan="2" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Margin="1" 
                                   Placement="Bottom" 
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource CardBgBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect" 
                                                           Fill="{Binding Background, ElementName=dropDownBorder}" 
                                                           Height="{Binding ActualHeight, ElementName=dropDownBorder}" 
                                                           Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" 
                                                            KeyboardNavigation.DirectionalNavigation="Contained" 
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter Property="Height" TargetName="dropDownBorder" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="itemBorder" Value="{DynamicResource WindowBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" TargetName="itemBorder" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Modern TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,16,0,0"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAlternatingBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#64748B"/>
                                <Setter Property="BorderThickness" TargetName="border" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ListView Style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="itemBorder" Value="{DynamicResource WindowBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" TargetName="itemBorder" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/app_icon.png" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Sağ Tık Yöneticisi" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Klasör ve uygulama kısayolları ekleyin, gruplandırın ve Windows 11 sağ tık menüsünü düzenleyin." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="ThemeToggleBtn" Grid.Column="2" Content="🌙 Karanlık Tema" Width="140" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="ThemeToggleBtn_Click"/>
        </Grid>
        
        <!-- Main Body Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Side: Add Shortcut Form (Scrollable) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock x:Name="FormTitleLabel" Text="Yeni Kısayol Ekle" FontSize="16" FontWeight="Bold" Style="{StaticResource LabelStyle}" Margin="0,0,0,16"/>
                            
                            <!-- Shortcut Type -->
                            <TextBlock Text="Kısayol Türü" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="TypeCombo" Margin="0,0,0,16" SelectedIndex="0" SelectionChanged="TypeCombo_SelectionChanged">
                                <ComboBoxItem Content="Klasör"/>
                                <ComboBoxItem Content="Dosya / Program"/>
                            </ComboBox>
                            
                            <!-- Target Type (Background, Directory, AllFiles, FileExtension) -->
                            <TextBlock Text="Hedef Alan (Nerede Görünsün?)" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="TargetCombo" Margin="0,0,0,16" SelectedIndex="0" SelectionChanged="TargetCombo_SelectionChanged">
                                <ComboBoxItem Content="Boş Alan (Desktop veya Klasör İçi)"/>
                                <ComboBoxItem Content="Klasörün Kendisi"/>
                                <ComboBoxItem Content="Tüm Dosyalar (Herhangi bir dosya)"/>
                                <ComboBoxItem Content="Belirli Dosya Uzantısı"/>
                            </ComboBox>

                            <!-- Specific Extension Panel -->
                            <StackPanel x:Name="ExtensionPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="Dosya Uzantısı (örneğin: .txt)" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ExtensionTxt" Height="36" VerticalContentAlignment="Center" Text=".txt" TextChanged="ExtensionTxt_TextChanged"/>
                            </StackPanel>
                            
                            <!-- Menu Group -->
                            <TextBlock Text="Menü Grubu (Submenu)" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="GroupCombo" IsEditable="False" Margin="0,0,0,16" Text="Ana Menü"/>
                            
                            <!-- Display Name -->
                            <TextBlock Text="Menüde Görünecek Ad" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="NameTxt" Margin="0,0,0,16" Height="36" VerticalContentAlignment="Center"/>
                            
                            <!-- Position Selection -->
                            <TextBlock Text="Menü Konumu (Sıralama)" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="PositionCombo" Margin="0,0,0,16" SelectedIndex="0">
                                <ComboBoxItem Content="Varsayılan (Alfabetik)"/>
                                <ComboBoxItem Content="En Üstte (Top)"/>
                                <ComboBoxItem Content="En Altta (Bottom)"/>
                            </ComboBox>
                            
                            <!-- Target Path -->
                            <TextBlock x:Name="PathLabel" Text="Hedef Klasör Yolu" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathTxt" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="PathTxt_TextChanged"/>
                                <Button x:Name="BrowseBtn" Grid.Column="1" Content="Gözat..." Width="80" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseBtn_Click"/>
                            </Grid>
                            
                            <!-- Custom Icon Path -->
                            <TextBlock Text="Özel İkon Yolu (İsteğe Bağlı)" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IconTxt" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="IconBrowseBtn" Grid.Column="1" Content="Seç..." Width="80" Style="{StaticResource SecondaryButtonStyle}" Click="IconBrowseBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Submit Buttons -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Button x:Name="AddBtn" Content="Kısayolu Menüye Ekle" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="AddBtn_Click"/>
                        
                        <Grid x:Name="EditBtnGrid" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveEditBtn" Grid.Column="0" Content="Değişiklikleri Kaydet" Height="40" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Click="SaveEditBtn_Click"/>
                            <Button x:Name="CancelEditBtn" Grid.Column="1" Content="Vazgeç" Height="40" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelEditBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Right Side: Settings & Tabs -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- System Settings Card -->
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Sistem Ayarları" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ClassicMenuChk" Content="Windows 11 Klasik Sağ Tık Menüsünü Etkinleştir (Explorer yeniden başlatılır)" Margin="0,0,0,12" Click="ClassicMenuChk_Click"/>
                        <CheckBox x:Name="PowerShellChk" Content="PowerShell Penceresini Burada Aç seçeneğini sabitle (Shift tuşuna basmak gerekmez)" Margin="0,0,0,12" Click="PowerShellChk_Click"/>
                        <CheckBox x:Name="CopyAsPathChk" Content="Yol Olarak Kopyala seçeneğini sabitle (Shift tuşuna basmak gerekmez)" Click="CopyAsPathChk_Click"/>
                    </StackPanel>
                </Border>
                
                <!-- TabControl Card -->
                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
                    <TabControl>
                        
                        <!-- TAB 1: SHORTCUTS LIST -->
                        <TabItem Header="Eklenen Kısayollar">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- DataGrid showing shortcuts -->
                                <DataGrid x:Name="ShortcutsGrid" Grid.Row="0" AutoGenerateColumns="False" MouseDoubleClick="ShortcutsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hedef Alan" Binding="{Binding TargetDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Grup (Menü)" Binding="{Binding Group}" Width="130"/>
                                        <DataGridTextColumn Header="Görünecek Ad" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Sıralama" Binding="{Binding Position}" Width="90"/>
                                        <DataGridTextColumn Header="Hedef Yol" Binding="{Binding Path}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                
                                <!-- List Buttons -->
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="EditBtn" Content="Seçileni Düzenle" Width="150" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="EditBtn_Click"/>
                                        <Button x:Name="DeleteBtn" Content="Seçilen Kısayolu Sil" Width="170" Height="38" Style="{StaticResource DangerButtonStyle}" Click="DeleteBtn_Click"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshBtn" HorizontalAlignment="Right" Content="Listeyi Yenile" Width="130" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshBtn_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                        
                        <!-- TAB 2: QUICK PRESETS -->
                        <TabItem Header="Hazır Şablonlar (Hızlı Eylemler)">
                            <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Preset 1: Restart Explorer -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Gezgini Yeniden Başlat" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Windows arayüzünü (explorer.exe) sonlandırıp yeniden başlatır. Donma ve takılmaları düzeltir." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Konum: Boş Alan (Masaüstü)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Menüye Ekle" Width="120" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="PresetExplorer_Click"/>
                                        </Grid>
                                    </Border>
 
                                    <!-- Preset 2: Open Admin CMD Here -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Yönetici Komut İstemi (CMD) Burada Aç" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Sağ tıkladığınız konumda doğrudan Yönetici olarak çalıştırılmış CMD penceresi başlatır." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Konum: Boş Alan ve Klasörün Kendisi (İkisine birden eklenir)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Menüye Ekle" Width="120" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="PresetAdminCmd_Click"/>
                                        </Grid>
                                    </Border>
 
                                    <!-- Preset 3: Temp Cleaner -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Geçici Dosyaları Temizle (Temp Cleaner)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Bilgisayarınızdaki geçici Windows Temp dosyalarını arka planda PowerShell ile hızlıca siler." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Konum: Boş Alan (Masaüstü)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Menüye Ekle" Width="120" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="PresetTempCleaner_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Preset 4: Toggle Hidden Files -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Gizli Dosyaları Göster / Gizle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Gizli ve korunan sistem dosyalarının görünürlüğünü tek tıkla açıp kapatır." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Konum: Boş Alan (Masaüstü)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Menüye Ekle" Width="120" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="PresetToggleHidden_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Preset 5: Toggle File Extensions -->
                                    <Border Padding="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Dosya Uzantılarını Göster / Gizle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Dosya isimlerinin sonundaki uzantıları (.txt, .png vb.) gösterir veya gizler." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Konum: Boş Alan (Masaüstü)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Menüye Ekle" Width="120" Height="36" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="PresetToggleExtensions_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <!-- TAB 3: MENU CLEANER -->
                        <TabItem Header="Menü Temizleme (Temizlik Aracı)">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <DataGrid x:Name="ShellExtensionsGrid" Grid.Row="0" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Uygulama / Öğe Adı" Binding="{Binding KeyName}" Width="200"/>
                                        <DataGridTextColumn Header="Hedef Alan" Binding="{Binding TargetDisplay}" Width="150"/>
                                        <DataGridCheckBoxColumn Header="Engelli (Devre Dışı)" Binding="{Binding IsBlocked}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="GUID / CLSID" Binding="{Binding Clsid}" Width="280"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="ToggleBlockedBtn" Content="Devre Dışı Bırak / Etkinleştir" Width="220" Height="38" Style="{StaticResource PrimaryButtonStyle}" Click="ToggleBlockedBtn_Click"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshExtensionsBtn" HorizontalAlignment="Right" Content="Listeyi Yenile" Width="130" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshExtensionsBtn_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: Şifreli Menüler (Kilitli Gruplar) -->
                        <TabItem Header="Şifreli Menüler (Kilitli Gruplar)">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Panel: Lock an existing group -->
                                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Mevcut Bir Grubu Şifreyle Kilitle" FontSize="15" FontWeight="Bold" Style="{StaticResource LabelStyle}" Margin="0,0,0,12"/>
                                        
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Select Group -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Kilitlenecek Alt Menü (Grup)" FontSize="12" FontWeight="SemiBold" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="LockGroupCombo" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Password -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="Erişim Şifresi" FontSize="12" FontWeight="SemiBold" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                                <PasswordBox x:Name="LockPasswordTxt" Height="36" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <!-- Timeout -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Açık Kalma Süresi (Saniye)" FontSize="12" FontWeight="SemiBold" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="LockDurationTxt" Text="90" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button x:Name="LockGroupBtn" Grid.Row="2" Content="Grubu Şifreyle Kilitle" Height="38" Margin="0,16,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="LockGroupBtn_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Panel: List of currently locked groups -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="Şu Anda Şifreli (Kilitli) Gruplar" FontSize="15" FontWeight="Bold" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                                    
                                    <!-- List of locked groups -->
                                    <ListView x:Name="LockedGroupsList" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Grup İsmi" DisplayMemberBinding="{Binding Key}" Width="150"/>
                                                <GridViewColumn Header="Açık Kalma Süresi (Sn)" DisplayMemberBinding="{Binding Value.UnlockDurationSeconds}" Width="150"/>
                                                <GridViewColumn Header="Kısayol Sayısı" DisplayMemberBinding="{Binding Value.Items.Count}" Width="120"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    
                                    <Button x:Name="UnlockPermanentlyBtn" Grid.Row="2" Content="Seçilen Grubun Şifresini/Kilidini Kaldır (Kalıcı Olarak Çöz)" Height="38" Style="{StaticResource DangerButtonStyle}" Click="UnlockPermanentlyBtn_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: CATEGORY / SUBMENU MANAGEMENT -->
                        <TabItem Header="Kategoriler (Alt Menüler)">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left side: Add Submenu Form -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock x:Name="GroupFormTitleLabel" Text="Yeni Kategori Oluştur" FontSize="15" FontWeight="Bold" Style="{StaticResource LabelStyle}" Margin="0,0,0,12"/>

                                        <!-- Submenu Name -->
                                        <TextBlock Text="Kategori (Alt Menü) Adı" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="GroupNameTxt" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                                        <!-- Target Type -->
                                        <TextBlock Text="Hedef Alan" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="GroupTargetCombo" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectedIndex="0" SelectionChanged="GroupTargetCombo_SelectionChanged">
                                            <ComboBoxItem Content="Boş Alan (Desktop veya Klasör İçi)"/>
                                            <ComboBoxItem Content="Klasörün Kendisi"/>
                                            <ComboBoxItem Content="Tüm Dosyalar (Herhangi bir dosya)"/>
                                            <ComboBoxItem Content="Belirli Dosya Uzantısı"/>
                                        </ComboBox>

                                        <!-- Specific Extension Panel -->
                                        <StackPanel x:Name="GroupExtensionPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                            <TextBlock Text="Dosya Uzantısı (örneğin: .txt)" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="GroupExtensionTxt" Height="36" VerticalContentAlignment="Center" Text=".txt"/>
                                        </StackPanel>

                                        <!-- Position Selection -->
                                        <TextBlock Text="Menü Konumu (Sıralama)" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="GroupPositionCombo" Margin="0,0,0,12" SelectedIndex="0">
                                            <ComboBoxItem Content="Varsayılan (Alfabetik)"/>
                                            <ComboBoxItem Content="En Üstte (Top)"/>
                                            <ComboBoxItem Content="En Altta (Bottom)"/>
                                        </ComboBox>

                                        <!-- Custom Icon Path -->
                                        <TextBlock Text="Özel Kategori İkonu" Style="{StaticResource LabelStyle}"/>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GroupIconTxt" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                            <Button x:Name="GroupIconBrowseBtn" Grid.Column="1" Content="Seç..." Width="60" Style="{StaticResource SecondaryButtonStyle}" Click="GroupIconBrowseBtn_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Button x:Name="AddGroupBtn" Content="Kategori Oluştur" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="AddGroupBtn_Click"/>
                                            
                                            <Grid x:Name="EditGroupBtnGrid" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="SaveEditGroupBtn" Grid.Column="0" Content="Değişiklikleri Kaydet" Height="40" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Click="SaveEditGroupBtn_Click"/>
                                                <Button x:Name="CancelEditGroupBtn" Grid.Column="1" Content="Vazgeç" Height="40" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelEditGroupBtn_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Right side: Categories List -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="CategoriesGrid" Grid.Row="0" AutoGenerateColumns="False" MouseDoubleClick="CategoriesGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kategori Adı" Binding="{Binding Name}" Width="150"/>
                                            <DataGridTextColumn Header="Hedef Alan" Binding="{Binding TargetDisplay}" Width="120"/>
                                            <DataGridTextColumn Header="İkon Yolu" Binding="{Binding IconPath}" Width="*"/>
                                            <DataGridTextColumn Header="Sıralama" Binding="{Binding Position}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button x:Name="EditGroupBtn" Content="Seçileni Düzenle" Width="150" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="EditGroupBtn_Click"/>
                                            <Button x:Name="DeleteGroupBtn" Content="Seçilen Kategoriyi Sil" Width="180" Height="38" Style="{StaticResource DangerButtonStyle}" Click="DeleteGroupBtn_Click"/>
                                        </StackPanel>
                                        <Button x:Name="RefreshGroupsBtn" HorizontalAlignment="Right" Content="Listeyi Yenile" Width="130" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshGroupsBtn_Click"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
